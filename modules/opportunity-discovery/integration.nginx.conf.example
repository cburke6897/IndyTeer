# Inside your existing HTTPS server block; static SPA configuration stays separate.
# Only the authenticated/public-safe integration interface is exposed.
location ^~ /api/discovery/ {
    proxy_pass http://127.0.0.1:5188/api/integration/;
    proxy_set_header Host 127.0.0.1:5188;
    proxy_set_header Origin "";
    proxy_set_header X-IndyTeer-Integration 1;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Discovery-Token $http_x_discovery_token;
    proxy_connect_timeout 3s;
    proxy_read_timeout 65s;
    proxy_next_upstream off;
}
# Do not proxy /api/* or expose port 5188 publicly. Keep this route ahead of SPA fallback.
