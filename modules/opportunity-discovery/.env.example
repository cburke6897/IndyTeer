# Optional. DEMO_KEY works for initial evaluation with lower official limits.
NPS_API_KEY=DEMO_KEY
DISCOVERY_PORT=5188
DISCOVERY_STATES=IN
# Use ALL for a bounded national scan, or IN,IL,OH for several states.
DISCOVERY_HORIZON_DAYS=30
# A contact address is recommended when enabling additional approved web sources.
DISCOVERY_CONTACT=
# Browser-safe values only. Import uses the signed-in person's own Auth session.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DISCOVERY_ENABLE_IMPORTS=false
