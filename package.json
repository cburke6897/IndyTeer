{
  "name": "indyteer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-public-env.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "node --test scripts/database.test.mjs scripts/stabilization.test.mjs",
    "types:generate": "node scripts/generate-types.mjs",
    "check:edge": "npm exec --yes --package=deno -- deno check supabase/functions/delete-account/index.ts supabase/functions/delete-organization/index.ts supabase/functions/background-worker/index.ts",
    "check": "npm run lint && npm test && npm run test:db && npm run test:config && npm run build",
    "test:config": "node --test scripts/config.test.mjs",
    "test:e2e": "playwright test",
    "test:edge": "npm exec --yes --package=deno -- deno test --allow-env supabase/functions/tests",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:live": "node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
